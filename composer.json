{
    "name": "byte8/module-migration-forecast",
    "description": "Forecast what setup:upgrade will do to your Magento 2 database before you run it — pending DDL classified against MySQL's online-DDL matrix and costed by live row counts.",
    "type": "magento2-module",
    "license": "MIT",
    "keywords": [
        "magento",
        "magento2",
        "magento-2",
        "mage-os",
        "setup-upgrade",
        "declarative-schema",
        "db_schema",
        "online-ddl",
        "zero-downtime",
        "deployment"
    ],
    "homepage": "https://byte8.io/orbit",
    "support": {
        "email": "helo@byte8.io"
    },
    "authors": [
        {
            "name": "Byte8 Ltd",
            "email": "helo@byte8.io"
        }
    ],
    "require": {
        "php": "^8.1",
        "magento/framework": "^103.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Byte8\\MigrationForecast\\": ""
        }
    },
    "version": "0.1.0"
}
